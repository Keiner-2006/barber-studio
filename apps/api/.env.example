# Database
# Central database containing tenants, memberships and platform sessions.
PLATFORM_DATABASE_URL=postgresql://user:password@localhost:5432/navaja_platform
# Optional development template. The tenant database name replaces {database}.
TENANT_DATABASE_URL_TEMPLATE=postgresql://user:password@localhost:5432/{database}
DATABASE_URL=postgresql://user:password@localhost:5432/navaja_db
# Use the Render internal hostname only when the API is deployed inside Render.
DATABASE_INTERNAL_URL=postgresql://user:password@internal-host/tenant_db

# Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
