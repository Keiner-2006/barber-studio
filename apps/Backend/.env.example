# ============================================
# DATABASE (Render — PostgreSQL)
# ============================================
# Usar la URL INTERNA de Render (dpg-xxx-xxx.oregon-postgres.render.com, sin .oregon-postgres)
# Esta URL funciona entre servicios dentro de la red de Render.
DATABASE_INTERNAL_URL=postgresql://user:password@host:5432/dbname

# URL externa (solo para acceso desde fuera de Render, requiere sslmode=require)
DATABASE_URL=postgresql://user:password@host.oregon-postgres.render.com:5432/dbname?sslmode=require

# URL de la plataforma (fallback si no hay DATABASE_INTERNAL_URL)
PLATFORM_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Schema de base de datos
DB_SCHEMA=public
# Desactivar SSL si usas la URL interna de Render (recomendado)
DB_SSL=false

# ============================================
# BETTER AUTH
# ============================================
BETTER_AUTH_URL=https://tu-backend.onrender.com
BETTER_AUTH_SECRET=tu-secret-de-almenos-32-caracteres
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_UPLOAD_PRESET=Barber_Studio

# ============================================
# APP
# ============================================
NODE_ENV=production
NEST_APP_URL=https://tu-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://tu-frontend.vercel.app

# ============================================
# CORS
# ============================================
CORS_ORIGINS=https://tu-frontend.vercel.app

# ============================================
# AUTH (demo)
# ============================================
DEMO_AUTH=false
