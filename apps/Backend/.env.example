# Database
# Central database containing tenants, memberships and platform sessions.
PLATFORM_DATABASE_URL=postgresql://user:password@localhost:5432/navaja_platform
DATABASE_URL=postgresql://user:password@localhost:5432/navaja_db

# Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
NODE_ENV=development
NEST_APP_URL=http://localhost:3001

# CORS
CORS_ORIGINS=http://localhost:4200,https://navaja.app
