{
  "name": "navaja-studio-os",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @navaja/backend --filter @navaja/frontend dev",
    "dev:api": "pnpm --filter @navaja/backend dev",
    "dev:api-nest": "pnpm --filter @navaja/backend dev",
    "dev:web": "pnpm --filter @navaja/frontend dev",
    "build": "pnpm run --parallel build:api-nest build:web",
    "build:api": "pnpm --filter @navaja/backend build",
    "build:api-nest": "pnpm --filter @navaja/backend build",
    "build:web": "pnpm --filter @navaja/frontend build",
    "lint": "pnpm run --parallel lint:api lint:web",
    "lint:api": "pnpm --filter @navaja/api lint",
    "lint:web": "pnpm --filter @navaja/web lint",
    "typecheck": "pnpm run --parallel typecheck:api-nest typecheck:web",
    "typecheck:api": "pnpm --filter @navaja/backend typecheck",
    "typecheck:api-nest": "pnpm --filter @navaja/backend typecheck",
    "typecheck:web": "pnpm --filter @navaja/frontend typecheck",
    "test:api-nest": "pnpm --filter @navaja/backend test",
    "db:generate": "pnpm --filter @navaja/api db:generate",
    "db:migrate": "pnpm --filter @navaja/api db:migrate",
    "db:seed": "pnpm --filter @navaja/api db:seed"
  },
  "devDependencies": {
    "bcrypt": "^6.0.0"
  }
}
